# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

# Load the real-time kinematics component specified in the .ini file
loadrt [KINS]KINEMATICS

# Load the Enhanced Motion Control real-time component as specified in the .ini file
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

# Load the LinuxCNC-EtherCAT configuration as specified in the .ini file
loadusr -W lcec_conf [LCEC]CONFIG

# Load LinuxCNC-Ethercat
loadrt lcec

# Load a PID real-time component named "x-pid", "y-pid", and "z-pid"
loadrt pid names=x-pid,y-pid,z-pid

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
# Threads
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

addf lcec.read-all servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf x-pid.do-pid-calcs servo-thread
addf y-pid.do-pid-calcs servo-thread
addf z-pid.do-pid-calcs servo-thread
addf lcec.write-all servo-thread

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
# Nots for limit switches
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
loadrt not count=3

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
# X-Axis 
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

# X axis PID controller setup with settings from .ini file
setp x-pid.Pgain [JOINT_0]P
setp x-pid.Igain [JOINT_0]I
setp x-pid.Dgain [JOINT_0]D
setp x-pid.FF1 [JOINT_0]FF1
setp x-pid.FF2 [JOINT_0]FF2
setp x-pid.deadband [JOINT_0]DEADBAND
setp x-pid.maxoutput [JOINT_0]MAX_OUTPUT

# X-Axis PID nets
net x-enable => x-pid.enable
net x-pos-cmd => x-pid.command
net x-pos-fb => x-pid.feedback
net x-pos-fb => joint.0.motor-pos-fb
net x-vel-cmd <= x-pid.output

# X Home Switch
addf not.0 servo-thread
net x-home-sw-raw <= lcec.0.din-0.din-3
net x-home-sw-raw => not.0.in
net x-home-sw <= not.0.out
net x-home-sw => joint.0.home-sw-in

# X axis interface
net x-enable <= joint.0.amp-enable-out
net x-amp-fault => joint.0.amp-fault-in
net x-pos-cmd <= joint.0.motor-pos-cmd
net x-homed <= joint.0.homed
net x-homing <= joint.0.homing
net x-home-sw => joint.0.neg-lim-sw-in
net x-home-sw => joint.0.pos-lim-sw-in

# X axis hardware connections
setp lcec.0.x-axis-drive.srv-0-scale [JOINT_0]SCALE
net x-enable => lcec.0.x-axis-drive.srv-0-enable
net x-amp-fault <= lcec.0.x-axis-drive.srv-0-error
net x-vel-cmd => lcec.0.x-axis-drive.srv-0-cmd



# X Encoder
setp lcec.0.x-axis-drive.enc-0-pos-scale [JOINT_0]SCALE
net x-pos-fb <= lcec.0.x-axis-drive.enc-0-pos

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
# Y-Axis 
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

# Y axis PID controller setup with settings from .ini file
setp y-pid.Pgain [JOINT_1]P
setp y-pid.Igain [JOINT_1]I
setp y-pid.Dgain [JOINT_1]D
setp y-pid.FF1 [JOINT_1]FF1
setp y-pid.FF2 [JOINT_1]FF2
setp y-pid.deadband [JOINT_1]DEADBAND
setp y-pid.maxoutput [JOINT_1]MAX_OUTPUT

# Y-Axis PID nets
net y-enable => y-pid.enable
net y-pos-cmd => y-pid.command
net y-pos-fb => y-pid.feedback
net y-pos-fb => joint.1.motor-pos-fb
net y-vel-cmd <= y-pid.output

# Y Home Switch
addf not.1 servo-thread
net y-home-sw-raw <= lcec.0.din-0.din-4
net y-home-sw-raw => not.1.in
net y-home-sw <= not.1.out
net y-home-sw => joint.1.home-sw-in

# Y axis interface
net y-enable <= joint.1.amp-enable-out
net y-amp-fault => joint.1.amp-fault-in
net y-pos-cmd <= joint.1.motor-pos-cmd
net y-homed <= joint.1.homed
net y-homing <= joint.1.homing

# Y-Limits
net y-home-sw => joint.1.neg-lim-sw-in
net y-home-sw => joint.1.pos-lim-sw-in

# Y axis hardware connections
setp lcec.0.y-axis-drive.srv-0-scale [JOINT_1]SCALE
net y-enable => lcec.0.y-axis-drive.srv-0-enable
net y-amp-fault <= lcec.0.y-axis-drive.srv-0-error
net y-vel-cmd => lcec.0.y-axis-drive.srv-0-cmd

# Y Encoder
setp lcec.0.y-axis-drive.enc-0-pos-scale [JOINT_1]SCALE
net y-pos-fb <= lcec.0.y-axis-drive.enc-0-pos

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
# Z-Axis 
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 

# Z axis PID controller setup with settings from .ini file
setp z-pid.Pgain [JOINT_2]P
setp z-pid.Igain [JOINT_2]I
setp z-pid.Dgain [JOINT_2]D
setp z-pid.FF1 [JOINT_2]FF1
setp z-pid.FF2 [JOINT_2]FF2
setp z-pid.deadband [JOINT_2]DEADBAND
setp z-pid.maxoutput [JOINT_2]MAX_OUTPUT

# Z-Axis PID nets
net z-enable => z-pid.enable
net z-pos-cmd => z-pid.command
net z-pos-fb => z-pid.feedback
net z-pos-fb => joint.2.motor-pos-fb
net z-vel-cmd <= z-pid.output

# Z Home Switch
addf not.2 servo-thread
net z-home-sw-raw <= lcec.0.din-0.din-5
net z-home-sw-raw => not.2.in
net z-home-sw <= not.2.out
net z-home-sw => joint.2.home-sw-in

# Z axis interface
net z-enable <= joint.2.amp-enable-out
net z-amp-fault => joint.2.amp-fault-in
net z-pos-cmd <= joint.2.motor-pos-cmd
net z-homed <= joint.2.homed
net z-homing <= joint.2.homing
net z-home-sw => joint.2.neg-lim-sw-in
net z-home-sw => joint.2.pos-lim-sw-in

# Z axis hardware connections
setp lcec.0.z-axis-drive.srv-0-scale [JOINT_2]SCALE
net z-enable => lcec.0.z-axis-drive.srv-0-enable
net z-amp-fault <= lcec.0.z-axis-drive.srv-0-error
net z-vel-cmd => lcec.0.z-axis-drive.srv-0-cmd

# Z axis encoder
setp lcec.0.z-axis-drive.enc-0-pos-scale [JOINT_2]SCALE
net z-pos-fb <= lcec.0.z-axis-drive.enc-0-pos



# Z axis brake
net z-brake-release <= lcec.0.z-axis-drive.srv-0-ready
net z-brake-release => lcec.0.dout-0.dout-2

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
# E-Stop
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
# Estop simulation connections
net estop-ext	<= lcec.0.din-0.din-2
net estop-out	<= iocontrol.0.user-enable-out
net estop-ext	=> iocontrol.0.emc-enable-in


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Problem
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
loadrt logic names=problem_flags personality=0x206
addf problem_flags servo-thread
# X-Axis
net x-axis-power-good <= lcec.0.din-ns-0.din-2-not
net x-axis-power-good => problem_flags.in-00
net x-amp-fault => problem_flags.in-01
# Y-Axis
net y-axis-power-good <= lcec.0.din-ns-0.din-1-not
net y-axis-power-good => problem_flags.in-02
net y-amp-fault => problem_flags.in-03
# Z-Axis
net z-axis-power-good <= lcec.0.din-ns-0.din-3-not
net z-axis-power-good => problem_flags.in-04
net z-amp-fault => problem_flags.in-05
# Problem Output
net problem_out <= problem_flags.or
net problem_out => lcec.0.dout-0.dout-3

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Spindle Control
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
loadrt scale count=1
addf scale.0 servo-thread
setp scale.0.gain 0.000055555555
net spindle-speed-scale spindle.0.speed-out => scale.0.in
net spindle-speed-DAC scale.0.out => lcec.0.aout-0.aout-0-value
net spindle-on halui.spindle.0.is-on => lcec.0.aout-0.aout-0-enable
net spindle-forward spindle.0.forward => lcec.0.dout-0.dout-0

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Tool Changer fake-out?
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
net tool-prepare-loopback iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
