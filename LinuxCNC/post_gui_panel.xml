<pyvcp>

  <!-- the RPM meter -->
  <hbox>
    <relief>FLAT</relief>
    <meter>
      <halpin>"spindle_rpm"</halpin>
      <text>"Spindle"</text>
      <subtext>"RPM"</subtext>
      <size>200</size>
      <min_>0</min_>
      <max_>18000</max_>
      <majorscale>3000</majorscale>
      <minorscale>1000</minorscale>
      <region1>0,1000,"yellow"</region1>
    </meter>
  </hbox>

  <!-- the On Led -->
  <hbox>
    <relief>FLAT</relief>
    <label>
      <text>"Spindle Active: "</text>
      <font>("Helvetica",18)</font>
    </label>
    <rectled>
      <halpin>"spindle-on-led"</halpin>
      <height>"20"</height>
      <width>"20"</width>
      <on_color>"green"</on_color>
      <off_color>"red"</off_color>
    </rectled>
  </hbox>
  <vbox>
    <button>
      <halpin>"feed-override-100"</halpin>
      <text>"Feed Override 100%"</text>
    </button>
    <button>
      <halpin>"rapid-override-100"</halpin>
      <text>"Rapid Override 100%"</text>
    </button>
    <button>
      <halpin>"spindle-override-100"</halpin>
      <text>"Spindle Override 100%"</text>
    </button>
  </vbox>
</pyvcp>
